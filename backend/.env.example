# Copy to backend/.env and edit. Never commit the real .env file.
APP_ENV=development

# REQUIRED in production: generate with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# SQLite by default (zero setup). For PostgreSQL use e.g.
# DATABASE_URL=postgresql+psycopg://agrishield:password@localhost:5432/agrishield
DATABASE_URL=sqlite:///./agrishield.db

# Comma separated list, or * for development only
CORS_ORIGINS=*

# Trained artifacts (relative paths resolve from the repo root)
MODEL_PATH=ml/artifacts/agrishield_model.tflite
KERAS_MODEL_PATH=ml/artifacts/agrishield_model.keras
CLASS_NAMES_PATH=ml/artifacts/class_names.json
ADVISORY_DIR=advisory
UPLOAD_DIR=backend/uploads

# Limits / thresholds
MAX_UPLOAD_MB=8
MIN_CONFIDENCE=0.55
HEALTHY_CONFIDENCE=0.60
GRADCAM_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
WEATHER_CACHE_SECONDS=600
